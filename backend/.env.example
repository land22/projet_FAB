# Copier ce fichier vers .env (jamais commité) et adapter les valeurs.
# En local, aucun .env n'est necessaire : les valeurs par defaut dans
# settings.py reproduisent exactement le comportement actuel.

SECRET_KEY=change-moi-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Exemple pour un deploiement GitHub Pages (frontend) + PythonAnywhere (backend) :
# DEBUG=False
# ALLOWED_HOSTS=tonuser.pythonanywhere.com
# CORS_ALLOWED_ORIGINS=https://tonuser.github.io
